{
  "publisher": "JoinnerMedina",
  "icon": "icon.png",
  "name": "getx-folder-structure",
  "displayName": "Getx folder structure",
  "description": "Create a suitable initial structure adapted to work with the flutter Getx package",
  "version": "1.1.2",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "getx-folder-structure.createStructure",
        "title": "Flutter folder structure",
        "category": "Getx"
      }
    ],
    "keybindings": [
      {
        "command": "getx-folder-structure.createStructure",
        "key": "ctrl+shift+f",
        "when": "editorTextFocus && editorLangId == dart"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.2",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devjoi2018/getx-folder-structure.git"
  }
}
